# ===========================================
# DZP IAC Agent - Docker Environment Configuration
# ===========================================
# Copy this file to .env and configure for your environment

# ===========================================
# AI Provider Configuration
# ===========================================
# Supported providers: openai, openai_compatible
AI_PROVIDER=openai_compatible

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=4096

# OpenAI Compatible Endpoints (Ollama, LocalAI, LM Studio, etc.)
# For Ollama running in Docker, use: http://ollama:11434/v1
# For Ollama on host machine, use: http://host.docker.internal:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=llama3.1
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
OPENAI_COMPATIBLE_MAX_TOKENS=4096

# ===========================================
# DeepAgents Configuration
# ===========================================
# Enable multi-agent orchestration for complex workflows
USE_DEEPAGENTS=false
# Require human approval for critical operations (apply, destroy)
HUMAN_IN_THE_LOOP=true

# ===========================================
# Terraform Configuration
# ===========================================
TERRAFORM_PATH=terraform
TERRAFORM_WORKSPACE=default
# Path to Terraform files (mounted as volume in Docker)
TERRAFORM_DIR=/terraform

# ===========================================
# Application Configuration
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=
MAX_FILE_SIZE=10485760  # 10MB

# ===========================================
# UI Configuration
# ===========================================
UI_THEME=dark
AUTO_REFRESH=true
REFRESH_INTERVAL=30

# ===========================================
# Docker-Specific Configuration
# ===========================================
# Host machine path to Terraform files (for volume mounting)
# This path on your host will be mounted to /terraform in the container
HOST_TERRAFORM_DIR=./terraform

# ===========================================
# Optional: Ollama Configuration
# ===========================================
# Uncomment to use Ollama service
# Make sure to start with: docker-compose --profile with-ollama up
# OLLAMA_MODEL=llama3.1
# OLLAMA_PULL_ON_START=true
